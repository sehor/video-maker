            "type": "string",
            "title": "Tx Type"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          },
          "reference_type": {
            "type": "string",
            "title": "Reference Type"
          },
          "reference_id": {
            "type": "string",
            "title": "Reference Id"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "metadata_json": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata Json"
          },
          "postings": {
            "items": {
              "$ref": "#/components/schemas/LedgerPostingOut"
            },
            "type": "array",
            "title": "Postings"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tx_type",
          "idempotency_key",
          "reference_type",
          "reference_id",
          "unit",
          "metadata_json",
          "created_at"
        ],
        "title": "LedgerTransactionOut"
      },
      "TestGrantCreate": {
        "properties": {
          "tier": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "title": "Tier"
          },
          "amount_ms": {
            "type": "integer",
            "maximum": 86400000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Ms"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "tier",
          "amount_ms",
          "idempotency_key",
          "reason"
        ],
        "title": "TestGrantCreate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
