    "license_status": "GPL",
    "h264_decoders": ["h264", "h264_amf", "h264_cuvid", "h264_qsv"],
    "h264_encoders": [
      "h264_amf",
      "h264_mf",
      "h264_nvenc",
      "h264_qsv",
      "h264_vaapi",
      "libx264",
      "libx264rgb"
