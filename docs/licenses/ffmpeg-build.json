      "--enable-gmp",
      "--enable-bzlib",
      "--enable-lzma",
      "--enable-zlib",
      "--enable-libsrt",
      "--enable-libssh",
      "--enable-libzmq",
      "--enable-avisynth",
      "--enable-sdl2",
      "--enable-libwebp",
      "--enable-libx264",
      "--enable-libx265",
      "--enable-libxvid",
      "--enable-libaom",
      "--enable-libopenjpeg",
      "--enable-libvpx",
      "--enable-mediafoundation",
      "--enable-libass",
      "--enable-libfreetype",
      "--enable-libfribidi",
      "--enable-libharfbuzz",
      "--enable-libvidstab",
      "--enable-libvmaf",
      "--enable-libzimg",
      "--enable-amf",
      "--enable-cuda-llvm",
      "--enable-cuvid",
      "--enable-dxva2",
      "--enable-d3d11va",
