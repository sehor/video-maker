POSTGRES_DB=video_factory
POSTGRES_USER=video_factory
POSTGRES_PASSWORD=video_factory_dev
DATABASE_URL=postgresql+psycopg://video_factory:video_factory_dev@postgres:5432/video_factory
BETTER_AUTH_DATABASE_URL=postgresql://video_factory:video_factory_dev@postgres:5432/video_factory
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=video-factory-api
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=52428800
STORAGE_CLAIM_SECRET=replace-with-at-least-32-random-characters
STORAGE_CLAIM_TTL_SECONDS=300
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
MEDIA_PROBE_TIMEOUT_SECONDS=10
MEDIA_DECODE_TIMEOUT_SECONDS=60
MEDIA_CPU_TIME_SECONDS=60
MEDIA_PROBE_MAX_MEMORY_BYTES=1073741824
MEDIA_DECODE_MAX_MEMORY_BYTES=2147483648
MEDIA_MAX_OUTPUT_BYTES=1048576
MEDIA_CPU_COUNT=1
