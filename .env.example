

POSTGRES_DB=video-maker
POSTGRES_USER=postgres
# Fill in your local password in .env; no real password is committed here.
POSTGRES_PASSWORD=
ENVIRONMENT=development
# API uses SQLAlchemy with psycopg 3; percent-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/video-maker
# Create this separate database once with your PostgreSQL tools before running test/test-api.
# Never point TEST_DATABASE_URL at development; each run owns a fresh temporary schema only.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/video-maker_test

# Development-only runner starts with the API lifespan; no Hatchet token or worker needed.
# Production must use hatchet. Apply database migrations before checking /readyz.
WORKFLOW_BACKEND=local
# Optional Hatchet Cloud: select hatchet for API/worker and supply a development tenant token.
# File takes precedence; never commit tokens. scripts/dev.ps1 resolves file paths from repo root.
# HATCHET_CLIENT_TOKEN=
# HATCHET_CLIENT_TOKEN_FILE=
# HATCHET_CLIENT_TLS_STRATEGY=tls
# HATCHET_CLIENT_NAMESPACE=video_maker_dev
# Normally omit addresses and use those encoded in the Cloud token.
# HATCHET_CLIENT_HOST_PORT=your-grpc-host:443
# HATCHET_SERVER_URL=https://your-console-host
# Optional private CA/server-name overrides; never disable TLS for Cloud.
# HATCHET_CLIENT_TLS_ROOT_CA_FILE=
# HATCHET_CLIENT_TLS_SERVER_NAME=

# Better Auth uses node-postgres, so its URL must not include +psycopg.
BETTER_AUTH_DATABASE_URL=postgresql://postgres:@localhost:5432/video-maker
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=video-factory-api
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000
# scripts/dev.ps1 resolves relative storage paths from the repository root.
STORAGE_ROOT=./data/storage
MAX_UPLOAD_BYTES=52428800
STORAGE_CLAIM_SECRET=replace-with-at-least-32-random-characters
STORAGE_CLAIM_TTL_SECONDS=300
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
MEDIA_PROBE_TIMEOUT_SECONDS=10
MEDIA_DECODE_TIMEOUT_SECONDS=60
MEDIA_CPU_TIME_SECONDS=60
MEDIA_PROBE_MAX_MEMORY_BYTES=1073741824
MEDIA_DECODE_MAX_MEMORY_BYTES=2147483648
MEDIA_MAX_OUTPUT_BYTES=1048576
MEDIA_CPU_COUNT=1
CORS_ORIGINS=http://localhost:3000
E2E_BASE_URL=http://localhost:3000
