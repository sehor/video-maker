# Explicit container integration only: --env-file .env.compose --profile integration.
# Copy to .env.compose (ignored); never use for native dev or production.
POSTGRES_DB=video_factory
POSTGRES_USER=video_factory
POSTGRES_PASSWORD=change-me-compose-only
DATABASE_URL=postgresql+psycopg://video_factory:change-me-compose-only@postgres:5432/video_factory
ENVIRONMENT=development
WORKFLOW_BACKEND=hatchet
HATCHET_CLIENT_TOKEN_FILE=/hatchet-auth/token
HATCHET_CLIENT_HOST_PORT=hatchet:7077
HATCHET_SERVER_URL=http://hatchet:8888
HATCHET_CLIENT_TLS_STRATEGY=none
BETTER_AUTH_DATABASE_URL=postgresql://video_factory:change-me-compose-only@postgres:5432/video_factory
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_JWKS_URL=http://web:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=video-factory-api
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_AUTH_BASE_URL=http://localhost:3000
STORAGE_ROOT=/data/storage
STORAGE_CLAIM_SECRET=replace-with-at-least-32-random-characters
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
CORS_ORIGINS=http://localhost:3000
E2E_BASE_URL=http://web:3000
